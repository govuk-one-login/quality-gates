      "description": "notApplicable without phase is valid (backwards compat)",
      "valid": true,
      "data": {
        "services": [
          {
            "product": "service",
            "component": "api",
            "promotionType": "securePipelines",
            "notApplicable": [
              {
                "checks": [
                  { "name": "visual regression", "details": ["No user-facing UI"] }
                ]
              }
            ]
          }
        ]
      }
    },
    {
