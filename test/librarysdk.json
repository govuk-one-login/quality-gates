{
  "target": "../schemas/schema.json",
  "$comment": "GitHub Library SDK tests",
  "tests": [
    {
      "description": "Library",
      "valid": true,
      "data": {
        "services": [
          {
            "product": "generic-service",
            "component": "api",
            "promotionType": "library",
            "automated": [
              {
                "checks": [
                  {
                    "name": "unit"
                  }
                ],
                "provider": "GitHub",
                "phase": "pre-merge",
                "file": ".github/workflows/tests.yaml",
                "path": "$.jobs.unit"
              },
              {
                "checks": [
                  {
                    "name": "unit"
                  }
                ],
                "provider": "GitHub",
                "phase": "pre-release",
                "file": ".github/workflows/tests.yaml",
                "path": "$.jobs.unit"
              }
            ]
          }
        ]
      }
    }
  ]
}
