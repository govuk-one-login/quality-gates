{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "root",
  "description": "An annotation of existing commands that are used as checks in quality gates for the GOVUK One Login programme",
  "examples": [
    {
      "services": [
        {
          "product": "service-name",
          "component": "frontend",
          "promotionType": "securePipelines",
          "automated": [
            {
              "checks": [{ "name": "code style and linting" }],
              "provider": "GitHub",
              "phase": "pre-merge",
              "file": ".github/workflows/check-code-quality.yaml",
              "path": "$.jobs.pre-commit"
            }
          ]
        }
      ]
    }
  ],
  "type": "object",
  "properties": {
    "services": {
      "$ref": "#/$defs/services"
    }
  },
  "$defs": {
    "check-type": {
      "description": "A quality check category",
      "enum": [
        "accessibility",
        "canary",
        "code quality",
        "code style and linting",
        "contract",
        "cross service integration",
        "data compatibility",
        "integration",
        "secret scanning",
        "sensitive data scanning",
        "system",
        "unit test coverage",
        "unit",
        "visual regression",
        "vulnerability detection"
      ]
    },
    "scope": {
      "description": "The scope of an integration check",
      "enum": [
        "component",
        "product",
        "neighbour",
        "e2e"
      ]
    },
    "purpose": {
      "description": "The purpose of a check",
      "enum": [
        "regression",
        "new feature",
        "smoke",
        "performance"
      ]
    },
    "check": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/check-type"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "purpose": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/purpose"
          }
        }
      },
      "required": ["name"],
      "allOf": [
        {
          "if": {
            "not": {
              "properties": { "name": { "const": "integration" } }
            }
          },
          "then": {
            "not": { "required": ["scope"] }
          }
        },
        {
          "if": {
            "not": {
              "properties": { "name": { "enum": ["integration", "unit"] } }
            }
          },
          "then": {
            "not": { "required": ["purpose"] }
          }
        }
      ]
    },
    "check-with-details": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/check-type"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "purpose": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/purpose"
          }
        },
        "details": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      },
      "required": ["name", "details"],
      "allOf": [
        {
          "if": {
            "not": {
              "properties": { "name": { "const": "integration" } }
            }
          },
          "then": {
            "not": { "required": ["scope"] }
          }
        },
        {
          "if": {
            "not": {
              "properties": { "name": { "enum": ["integration", "unit"] } }
            }
          },
          "then": {
            "not": { "required": ["purpose"] }
          }
        }
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "automated-check": {
      "type": "object",
      "properties": {
        "checks": {
          "$ref": "#/$defs/checks"
        },
        "phase": {
          "type": "string"
        },
        "provider": {
          "enum": [
            "CloudFormation",
            "GitHub",
            "Stack Orchestration Tool",
            "Terraform"
          ]
        },
        "file": {
          "type": "string",
          "pattern": "^[^:]*$"
        },
        "path": {
          "description": "JSONPath (RFC 9535) expression identifying the relevant node in the file",
          "type": "string",
          "pattern": "^\\$"
        }
      },
      "required": [
        "checks",
        "phase",
        "provider",
        "file"
      ]
    },
    "manual-check": {
      "type": "object",
      "properties": {
        "checks": {
          "$ref": "#/$defs/checks"
        },
        "phase": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      },
      "required": [
        "checks",
        "phase",
        "details"
      ]
    },
    "out-of-band-check": {
      "type": "object",
      "properties": {
        "checks": {
          "$ref": "#/$defs/checks"
        },
        "phase": {
          "type": "string"
        },
        "provider": {
          "enum": [
            "CloudFormation",
            "GitHub",
            "Stack Orchestration Tool",
            "Terraform"
          ]
        },
        "file": {
          "type": "string",
          "pattern": "^[^:]*$"
        },
        "path": {
          "description": "JSONPath (RFC 9535) expression identifying the relevant node in the file",
          "type": "string",
          "pattern": "^\\$"
        }
      },
      "required": [
        "checks",
        "phase",
        "provider",
        "file"
      ]
    },
    "not-applicable-check": {
      "type": "object",
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check-with-details"
          }
        }
      },
      "required": ["checks"]
    },
    "automated-checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/automated-check"
      }
    },
    "manual-checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/manual-check"
      }
    },
    "out-of-band-checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/out-of-band-check"
      }
    },
    "not-applicable-checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/not-applicable-check"
      }
    },
    "secure-pipelines-phases": {
      "type": "object",
      "properties": {
        "automated": {
          "items": {
            "properties": {
              "phase": {
                "enum": ["pre-merge", "pre-upload", "build", "staging", "production", "integration"]
              }
            }
          }
        },
        "manual": {
          "items": {
            "properties": {
              "phase": {
                "enum": ["pre-merge", "pre-upload", "build", "staging", "production", "integration"]
              }
            }
          }
        },
        "outOfBand": {
          "items": {
            "properties": {
              "phase": {
                "enum": ["pre-merge", "pre-upload", "build", "staging", "production", "integration"]
              }
            }
          }
        }
      }
    },
    "git-flow-phases": {
      "type": "object",
      "properties": {
        "automated": {
          "items": {
            "properties": {
              "phase": {
                "enum": ["pre-develop", "develop", "pre-release", "release", "pre-main", "main"]
              }
            }
          }
        },
        "manual": {
          "items": {
            "properties": {
              "phase": {
                "enum": ["pre-develop", "develop", "pre-release", "release", "pre-main", "main"]
              }
            }
          }
        },
        "outOfBand": {
          "items": {
            "properties": {
              "phase": {
                "enum": ["pre-develop", "develop", "pre-release", "release", "pre-main", "main"]
              }
            }
          }
        }
      }
    },
    "library-phases": {
      "type": "object",
      "properties": {
        "automated": {
          "items": {
            "properties": {
              "phase": {
                "enum": ["pre-merge", "pre-release"]
              }
            }
          }
        },
        "manual": {
          "items": {
            "properties": {
              "phase": {
                "enum": ["pre-merge", "pre-release"]
              }
            }
          }
        },
        "outOfBand": {
          "items": {
            "properties": {
              "phase": {
                "enum": ["pre-merge", "pre-release"]
              }
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "required": [
        "product",
        "component",
        "promotionType"
      ],
      "properties": {
        "product": {
          "type": "string"
        },
        "component": {
          "type": "string"
        },
        "promotionType": {
          "enum": [
            "securePipelines",
            "gitFlow",
            "library",
            "other"
          ]
        },
        "promotionTypeDetails": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "automated": {
          "$ref": "#/$defs/automated-checks"
        },
        "manual": {
          "$ref": "#/$defs/manual-checks"
        },
        "outOfBand": {
          "$ref": "#/$defs/out-of-band-checks"
        },
        "notApplicable": {
          "$ref": "#/$defs/not-applicable-checks"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "promotionType": {
                "const": "securePipelines"
              }
            },
            "required": ["promotionType"]
          },
          "then": {
            "$ref": "#/$defs/secure-pipelines-phases"
          }
        },
        {
          "if": {
            "properties": {
              "promotionType": {
                "const": "gitFlow"
              }
            },
            "required": ["promotionType"]
          },
          "then": {
            "$ref": "#/$defs/git-flow-phases"
          }
        },
        {
          "if": {
            "properties": {
              "promotionType": {
                "const": "library"
              }
            },
            "required": ["promotionType"]
          },
          "then": {
            "$ref": "#/$defs/library-phases"
          }
        },
        {
          "if": {
            "properties": {
              "promotionType": {
                "const": "other"
              }
            },
            "required": ["promotionType"]
          },
          "then": {
            "required": ["promotionTypeDetails"]
          }
        }
      ]
    },
    "services": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/service"
      }
    }
  }
}
