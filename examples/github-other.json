{
  "services": [
    {
      "product": "service-name",
      "component": "frontend",
      "promotionType": "other",
      "promotionTypeDetails": ["custom deployment tool"],
      "automated": [
        {
          "checks": [{ "name": "unit" }],
          "provider": "GitHub",
          "phase": "deploy",
          "config": {
            "file": ".github/workflows/tests.yaml",
            "path": "$.jobs.unit"
          }
        }
      ]
    }
  ]
}
