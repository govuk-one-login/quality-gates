{
  "services": [
    {
      "product": "service-name",
      "component": "frontend",
      "promotionType": "securePipelines",
      "automated": [
        {
          "checks": [{ "name": "code style and linting" }],
          "provider": "GitHub",
          "phase": "pre-merge",
          "config": {
            "file": ".github/workflows/check-code-quality.yaml",
            "path": "$.jobs.pre-commit"
          }
        },
        {
          "checks": [{ "name": "code style and linting" }],
          "provider": "GitHub",
          "phase": "pre-merge",
          "config": {
            "file": ".github/workflows/check-code-quality.yaml",
            "path": "$.jobs.gitlint"
          }
        },
        {
          "checks": [{ "name": "code style and linting" }],
          "provider": "GitHub",
          "phase": "pre-merge",
          "config": {
            "file": ".github/workflows/check-code-quality.yaml",
            "path": "$.jobs.checkov"
          }
        }
      ]
    }
  ]
}
