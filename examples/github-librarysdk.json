{
  "services": [
    {
      "product": "service-name",
      "component": "frontend",
      "promotionType": "library",
      "automated": [
        {
          "checks": [
            {
              "name": "unit"
            }
          ],
          "provider": "GitHub",
          "phase": "pre-merge",
          "file": ".github/workflows/tests.yaml",
          "path": "$.jobs.unit"
        },
        {
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "provider": "GitHub",
          "phase": "pre-merge",
          "file": ".github/workflows/quality.yaml",
          "path": "$.jobs.lint.steps[?@.name=='Run linter']"
        },
        {
          "checks": [
            {
              "name": "unit"
            }
          ],
          "provider": "GitHub",
          "phase": "pre-release",
          "file": ".github/workflows/release.yaml",
          "path": "$.jobs.test"
        }
      ]
    }
  ]
}
