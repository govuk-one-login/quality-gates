{
  "services": [
    {
      "product": "service-name",
      "component": "frontend",
      "promotionType": "securePipelines",
      "automated": [
        {
          "checks": [
            {
              "name": "unit"
            }
          ],
          "provider": "GitHub",
          "phase": "pre-merge",
          "file": ".github/workflows/tests.yaml",
          "path": "$.jobs.unit"
        },
        {
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "provider": "GitHub",
          "phase": "pre-merge",
          "file": ".github/workflows/quality.yaml",
          "path": "$.jobs.pre-commit"
        },
        {
          "checks": [
            {
              "name": "vulnerability detection"
            }
          ],
          "provider": "GitHub",
          "phase": "pre-merge",
          "file": ".github/workflows/quality.yaml",
          "path": "$.jobs.codeql"
        }
      ],
      "notApplicable": [
        {
          "checks": [
            { "name": "visual regression", "details": ["No user-facing UI in this component"] }
          ]
        },
        {
          "phase": "build",
          "checks": [
            { "name": "integration", "details": ["No AWS resources to test at build phase"] }
          ]
        }
      ]
    }
  ]
}
