{
  "services": [
    {
      "product": "service-name",
      "component": "frontend",
      "promotionType": "gitFlow",
      "automated": [
        {
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "provider": "GitHub",
          "phase": "pre-develop",
          "file": ".github/workflows/lint.yaml",
          "path": "$.jobs.lint"
        },
        {
          "checks": [
            {
              "name": "unit"
            }
          ],
          "provider": "GitHub",
          "phase": "develop",
          "file": ".github/workflows/tests.yaml",
          "path": "$.jobs.unit"
        },
        {
          "checks": [
            {
              "name": "integration"
            }
          ],
          "provider": "GitHub",
          "phase": "pre-release",
          "file": ".github/workflows/integration.yaml",
          "path": "$.jobs.integration.steps[?@.name=='Run integration tests']"
        },
        {
          "checks": [
            {
              "name": "integration",
              "scope": "e2e"
            }
          ],
          "provider": "GitHub",
          "phase": "release",
          "file": ".github/workflows/e2e.yaml",
          "path": "$.jobs.e2e"
        },
        {
          "checks": [
            {
              "name": "integration",
              "purpose": [
                "smoke"
              ]
            }
          ],
          "provider": "GitHub",
          "phase": "main",
          "file": ".github/workflows/smoke.yaml",
          "path": "$.jobs.smoke"
        }
      ]
    }
  ]
}
