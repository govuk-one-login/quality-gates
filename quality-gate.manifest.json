{
  "$schema": "./schemas/schema.json",
  "services": [
    {
      "product": "quality-gates",
      "component": "quality-gates",
      "promotionType": "library",
      "automated": [
        {
          "checks": [
            {
              "name": "unit"
            }
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "file": ".github/workflows/schema.yml",
          "path": "$.jobs.run-tests"
        },
        {
          "checks": [
            {
              "name": "unit"
            }
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "file": ".github/workflows/visualiser.yml",
          "path": "$.jobs.run-tests"
        },
        {
          "checks": [
            {
              "name": "code quality"
            }
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "file": ".github/workflows/quality.yml",
          "path": "$.jobs.codeql"
        },
        {
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "file": ".github/workflows/quality.yml",
          "path": "$.jobs.pre-commit"
        }
      ]
    }
  ]
}
